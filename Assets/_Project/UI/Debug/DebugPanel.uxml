<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         editor="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <ui:Template name="DebugPanel" />
    <Style src="DebugPanel.uss" />

    <!-- ルート：全画面オーバーレイ -->
    <ui:VisualElement name="debug-root" class="debug-root">

        <!-- タイトルバー（ドラッグ可能想定） -->
        <ui:VisualElement name="title-bar" class="title-bar">
            <ui:Label name="title-label" text="デバッグパネル" class="title-label" />
        </ui:VisualElement>

        <!-- ツールバー -->
        <ui:VisualElement name="toolbar" class="toolbar">
            <ui:Button name="btn-speed-up" text="速度2倍" class="toolbar-btn" />
            <ui:Button name="btn-speed-reset" text="速度リセット" class="toolbar-btn" />
            <ui:Button name="btn-bgm-off" text="BGMオフ" class="toolbar-btn" />
            <ui:Button name="btn-save" text="セーブ" class="toolbar-btn" />
            <ui:DropdownField name="dropdown-chapter" label="チャプター" class="chapter-dropdown" />
        </ui:VisualElement>

        <!-- フィルターバー -->
        <ui:VisualElement name="filter-bar" class="filter-bar">
            <ui:DropdownField name="dropdown-episode" label="エピソード" class="episode-dropdown" />
            <ui:VisualElement name="tag-buttons" class="tag-buttons">
                <!-- タグボタンはC#から動的生成 -->
            </ui:VisualElement>
            <ui:TextField name="search-field" class="search-field" />
        </ui:VisualElement>

        <!-- アイテムグリッド（ScrollView） -->
        <ui:ScrollView name="item-grid-scroll" class="item-grid-scroll">
            <ui:VisualElement name="item-grid" class="item-grid">
                <!-- アイテムカードはC#から動的生成 -->
            </ui:VisualElement>
        </ui:ScrollView>

    </ui:VisualElement>
</ui:UXML>
