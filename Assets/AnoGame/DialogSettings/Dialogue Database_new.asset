        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: 'Ah tidak

          Maaf

          Bukan apa-apa'
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ah, no\nScusa\nNon \xE8 niente"
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Ah, n\xE3o, desculpe, n\xE3o \xE9 nada"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uC624, \uC544\uB2C8.\n\uBBF8\uC548\uD574.\n\uC544\uBB34\uAC83\uB3C4
