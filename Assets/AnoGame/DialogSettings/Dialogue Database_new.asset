      - title: de
        value: 'Ah, nein

          Entschuldigung

          Schon gut'
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0906\u0939, \u0928\u0939\u0940\u0902\n\u0915\u094D\u0937\u092E\u093E
          \u092E\u093E\u0902\u0917\u0928\u093E\n\u092F\u0939 \u0915\u0941\u091B \u092D\u0940
