      - title: de
        value: Gibt es einen Priester...?
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0915\u094D\u092F\u093E \u0915\u094B\u0908 \u092A\u0941\u091C\u093E\u0930\u0940
          \u0939\u0948...?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Apakah ada pendeta...?
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "C'\xE8 un prete...?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Ser\xE1 que tem o kannushi aqui...?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uC2E0\uC0AC \uC8FC\uC778\u2026 \uACC4\uC2E4\uAE4C\u2026?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u0415\u0441\u0442\u044C \u043B\u0438 \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A...?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: "\xBFHay un sacerdote...?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: Onko pappia...?
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: "Y a-t-il un pr\xEAtre... ?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u795E\u4E3B\u3055\u3093\u2026\u3044\u308B\u304B\u306A...?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u6709\u7267\u5E08\u5417\u2026\u2026\uFF1F"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: "\u6709\u7267\u5E08\u5417\u2026\u2026\uFF1F"
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: Is the shrine maiden... here?
        type: 4
        typeString: CustomFieldType_Localization
