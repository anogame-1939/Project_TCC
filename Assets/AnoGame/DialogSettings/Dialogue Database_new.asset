        type: 0
        typeString: 
      - title: de
        value: Oh, es ist die Dame von nebenan.
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0913\u0939, \u092F\u0939 \u092A\u0921\u093C\u094B\u0938 \u0935\u093E\u0932\u0940
          \u092E\u0939\u093F\u0932\u093E \u0939\u0948\u0964"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Oh, itu wanita di sebelah.
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Oh, \xE8 la signora della porta accanto."
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Ah, \xE9 a mo\xE7a da porta ao lado."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uC544, \uC606\uC9D1 \uC544\uC8FC\uBA38\uB2C8\uC2DC\uB2E4."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u041E, \u044D\u0442\u043E \u0434\u0430\u043C\u0430 \u043F\u043E
          \u0441\u043E\u0441\u0435\u0434\u0441\u0442\u0432\u0443."
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: "Oh, es la se\xF1ora de al lado."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: Oh, se on naapurin nainen.
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: "Oh, c'est la dame d'\xE0 c\xF4t\xE9."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u3042\u3001\u304A\u96A3\u306E\u304A\u3070\u3055\u3093\u3060"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u5662\uFF0C\u662F\u9694\u58C1\u7684\u90A3\u4F4D\u5973\u58EB\u3002"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: "\u5662\uFF0C\u662F\u9694\u58C1\u7684\u90A3\u4F4D\u5973\u58EB\u3002"
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: Ah, it's the lady next door.
        type: 4
        typeString: CustomFieldType_Localization
