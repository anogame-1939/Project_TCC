        type: 0
        typeString: 
      - title: de
        value: Schauen Sie, es ist hier platziert.
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0926\u0947\u0916\u093F\u092F\u0947, \u092F\u0939 \u092F\u0939\u093E\u0901
          \u0930\u0916\u093E \u0939\u0941\u0906 \u0939\u0948\u0964"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Lihat, itu ditempatkan di sini.
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Guarda, \xE8 messo qui."
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Olha, est\xE1 aqui, veja"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uBD10, \uC5EC\uAE30 \uB193\uC5EC \uC788\uC5B4\uC694"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435, \u043E\u043D\u043E
          \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u043E \u0437\u0434\u0435\u0441\u044C."
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: "Mira, est\xE1 colocado aqu\xED."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Katso, se on sijoitettu t\xE4nne."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: "Regardez, c'est plac\xE9 ici."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u307B\u3089\u3001\u3053\u3053\u306B\u7F6E\u3044\u3066\u3042\u308B\u3067\u3057\u3087\u3046\n"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u4F60\u770B\uFF0C\u5B83\u5C31\u653E\u5728\u8FD9\u91CC\u4E86\u3002"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: "\u4F60\u770B\uFF0C\u5B83\u5C31\u653E\u5728\u8FD9\u91CC\u4E86\u3002"
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: See? It's right here.
        type: 4
        typeString: CustomFieldType_Localization
