      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "\u307F\u3093\u306A\u672C\u5802\u306B\u4F9B\u3048\u3066\u308B\u308F\u3088\n\u79C1\u3082\u3053\u306E\u693F\u3092\u6301\u3063\u3066\u3044\u304F\u3068\u3053\u308D\u306A\u306E"
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Audio Files
        value: '[]'
        type: 3
        typeString: CustomFieldType_Files
      - title: Video File
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: canvasRect
        value: 
        type: 0
        typeString: 
      - title: EventGuid
        value: 
        type: 0
        typeString: 
      - title: Guid
        value: 298963f2-3f83-4cf6-967f-8eb34464c24f
        type: 0
        typeString: 
      - title: de
        value: 'Jeder spendet in die Haupthalle.

          Diese Kamelie werde ich
          auch gleich mitnehmen.'
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0939\u0930 \u0915\u094B\u0908 \u092E\u0941\u0916\u094D\u092F \u0939\u0949\u0932
          \u092E\u0947\u0902 \u092A\u094D\u0930\u0938\u093E\u0926 \u091A\u0922\u093C\u093E
          \u0930\u0939\u093E \u0939\u0948\u0964\n\u092E\u0948\u0902 \u0907\u0938
          \u0915\u092E\u0940\u0932\u092F\u093E \u0915\u094B \u092D\u0940 \u0905\u092A\u0928\u0947
          \u0938\u093E\u0925 \u0932\u0947 \u091C\u093E\u0928\u0947 \u0935\u093E\u0932\u093E
          \u0939\u0942\u0902\u0964"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: 'Semua orang menawarkan ke aula utama.

          Aku juga akan membawa
          bunga kamelia ini.'
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 'Tutti offrono alla sala principale.

          Sto per portare con
          me anche questa camelia.'
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Todos est\xE3o oferecendo flores no sal\xE3o principal. Eu tamb\xE9m
          estou indo levar esta cam\xE9lia para oferecer."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uBAA8\uB450 \uBCF8\uB2F9\uC5D0 \uAF43\uC744 \uBC14\uCE58\uACE0 \uC788\uC5B4.
          \uB098\uB3C4 \uC774 \uB3D9\uBC31\uAF43\uC744 \uB4E4\uACE0 \uAC00\uB294
          \uC911\uC774\uC57C."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u0412\u0441\u0435 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E\u0442
          \u0432 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0437\u0430\u043B.\n\u042F
          \u0442\u043E\u0436\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
          \u0432\u0437\u044F\u0442\u044C \u0441 \u0441\u043E\u0431\u043E\u0439 \u044D\u0442\u0443
          \u043A\u0430\u043C\u0435\u043B\u0438\u044E."
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: "Todos se ofrecen al sal\xF3n principal.\nEstoy a punto de llevarme
          esta camelia tambi\xE9n."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Kaikki tarjoavat p\xE4\xE4salille.\nOtan my\xF6s t\xE4m\xE4n kamelian
          mukaani."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: "Tout le monde s'offre dans la salle principale.\nJe suis sur le point
          d'emmener ce cam\xE9lia avec moi aussi."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u307F\u3093\u306A\u672C\u5802\u306B\u4F9B\u3048\u3066\u308B\u308F\u3088\n\u79C1\u3082\u3053\u306E\u693F\u3092\u6301\u3063\u3066\u3044\u304F\u3068\u3053\u308D\u306A\u306E"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u4F17\u4EBA\u7686\u5411\u5927\u6BBF\u4F9B\u5949\u3002\n\u6211\u4E5F\u51C6\u5907\u5E26\u8D70\u8FD9\u6735\u5C71\u8336\u82B1\u3002"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: "\u4F17\u4EBA\u7686\u5411\u5927\u6BBF\u4F9B\u5949\u3002\n\u6211\u4E5F\u51C6\u5907\u5E26\u8D70\u8FD9\u6735\u5C71\u8336\u82B1\u3002"
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: Everyone's offering theirs at the main hall. I'm on my way to take
          this camellia there too.
        type: 4
        typeString: CustomFieldType_Localization
