        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u0410\u0445, \u043D\u0435\u0442\n\u0438\u0437\u0432\u0438\u043D\u0438\n\u041D\u0438\u0447\u0435\u0433\u043E"
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: 'Ah no

          Lo siento

          No es nada'
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Ei\nanteeksi\nEi se mit\xE4\xE4n"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: "Ah non\nD\xE9sol\xE9\nCe n'est rien"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u3042\u3001\u3044\u3048\n\u3054\u3081\u3093\u306A\u3055\u3044\n\u306A\u3093\u3067\u3082\u306A\u3044\u306E"
        type: 4
