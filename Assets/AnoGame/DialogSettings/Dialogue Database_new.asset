        type: 0
        typeString: 
      - title: de
        value: Ja, ich habe Blumen mitgebracht.
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0939\u093E\u0901, \u092E\u0948\u0902 \u092B\u0942\u0932 \u0932\u093E\u092F\u093E
          \u0939\u0942\u0901\u0964"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Ya, saya membawa bunga.
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "S\xEC, ho portato dei fiori."
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: Sim, eu trouxe flores.
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uB124, \uAF43\uC744 \uAC00\uC838\uC654\uC5B4\uC694."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u0414\u0430, \u044F \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
          \u0446\u0432\u0435\u0442\u044B."
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: "S\xED, traje flores."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Kyll\xE4, toin kukkia."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: "Oui, j'ai apport\xE9 des fleurs."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u306F\u3044\u3001\u82B1\u3092\u6301\u3063\u3066\u304D\u305F\u3093\u3067\u3059"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u662F\u7684\uFF0C\u6211\u5E26\u4E86\u82B1\u3002"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: "\u662F\u7684\uFF0C\u6211\u5E26\u4E86\u82B1\u3002"
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: Yes, I brought flowers.
        type: 4
        typeString: CustomFieldType_Localization
