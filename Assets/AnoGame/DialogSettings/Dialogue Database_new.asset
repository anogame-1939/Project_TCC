      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "\u3044\u3044\u3048\u3001\u306A\u3093\u3067\u3082\u306A\u3044\u306E\n\u3055\u3001\u65E9\u304F\u304A\u4F9B\u3048\u306B\u884C\u304D\u307E\u3057\u3087\u3046"
        type: 0
        typeString: CustomFieldType_Text
      - title: Parenthetical
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Audio Files
        value: '[]'
