      - title: de
        value: '?

          Was ist das?'
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "?\n\u092F\u0939 \u0915\u094D\u092F\u093E \u0939\u0948?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: '?

          Apa itu?'
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "?\nChe cos'\xE8?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "?\nO que \xE9?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "?\n\uBB50\uC57C?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "?\n\u0427\u0442\u043E \u044D\u0442\u043E \u0442\u0430\u043A\u043E\u0435?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: "?\n\xBFQu\xE9 es?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "?\nMik\xE4 se on?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: '?

          Qu''est-ce que c''est?'
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\uFF1F\n\u306A\u3093\u3067\u3059\u304B\uFF1F"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
