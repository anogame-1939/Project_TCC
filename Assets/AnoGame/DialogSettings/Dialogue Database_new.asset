        value: Ah... das stimmt
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0906\u0939... \u092F\u0939 \u0938\u0939\u0940 \u0939\u0948"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Ah... benar sekali
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ah... \xE8 vero"
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Ah\u2026 foi isso"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uC544... \uB9DE\uC544"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u0410\u0445... \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430"
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: Ah...es cierto
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: Ah... aivan oikein
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: Ah... c'est vrai
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u3042...\u305D\u3046\u3060\u3063\u305F"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u554A\u2026\u2026\u539F\u6765\u5982\u6B64"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: "\u554A\u2026\u2026\u539F\u6765\u5982\u6B64"
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: Ah... I see.
        type: 4
        typeString: CustomFieldType_Localization
