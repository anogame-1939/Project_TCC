      - title: de
        value: Das...wurde meiner Oma geschenkt...
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u092F\u0939...\u092E\u0947\u0930\u0940 \u0926\u093E\u0926\u0940
          \u0915\u094B \u0926\u093F\u092F\u093E \u0917\u092F\u093E \u0925\u093E..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Ini...diberikan kepada nenekku...
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Questo...\xE8 stato regalato a mia nonna..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Isso\u2026 foi dado para mim pela minha av\xF3\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uC774\uAC74... \uD560\uBA38\uB2C8\uC5D0\uAC8C \uB118\uACA8\uC838..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u042D\u0442\u043E... \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0438
          \u043C\u043E\u0435\u0439 \u0431\u0430\u0431\u0443\u0448\u043A\u0435..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: "Esto... se lo regal\xF3 a mi abuela..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "T\xE4m\xE4... annettiin iso\xE4idilleni..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: "Ceci... a \xE9t\xE9 offert \xE0 ma grand-m\xE8re..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u3053\u308C\u306F...\u304A\u3070\u3042\u3061\u3083\u3093\u306B\u6E21\u3055\u308C\u3066\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u8FD9\u662F\u2026\u2026\u9001\u7ED9\u6211\u5976\u5976\u7684\u2026\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
