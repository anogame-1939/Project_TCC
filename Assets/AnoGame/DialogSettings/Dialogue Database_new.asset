      - title: de
        value: Seien Sie vorsichtig, wenn Sie nach Hause gehen
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u091C\u092C \u0906\u092A \u0918\u0930 \u091C\u093E\u090F\u0902 \u0924\u094B
          \u0938\u093E\u0935\u0927\u093E\u0928 \u0930\u0939\u0947\u0902"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Hati-hati saat pulang
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Fai attenzione quando torni a casa
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Volte para casa com cuidado, t\xE1?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uC870\uC2EC\uD574\uC11C \uB3CC\uC544\uAC00\uB834."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u0411\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D,
          \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u0439\u0434\u0435\u0448\u044C
          \u0434\u043E\u043C\u043E\u0439"
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: Ten cuidado cuando vuelvas a casa
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: Ole varovainen, kun menet kotiin
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: Soyez prudent lorsque vous rentrez chez vous
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u6C17\u3092\u3064\u3051\u3066\u5E30\u308B\u306E\u3088"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u56DE\u5BB6\u65F6\u8981\u5C0F\u5FC3"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: "\u56DE\u5BB6\u65F6\u8981\u5C0F\u5FC3"
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: Be careful on your way home.
        type: 4
        typeString: CustomFieldType_Localization
