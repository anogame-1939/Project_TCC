      - title: Dialogue Text
        value: "\u305D\u3046\u2026\n\u306A\u3089\u3001\u307E\u305F\u5F8C\u3067\u6765\u308C\u3070\u3044\u3044\u3093\u3058\u3083\u306A\u3044\uFF1F"
