      - title: de
        value: Ah, genau, Misaki-chan
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0906\u0939, \u092F\u0939 \u0938\u0939\u0940 \u0939\u0948 \u092E\u093F\u0938\u093E\u0915\u0940-\u091A\u093E\u0928"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Ah, benar Misaki-chan
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ah, \xE8 vero Misaki-chan"
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Ah, \xE9 isso mesmo, Misaki."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uC544, \uB9DE\uB2E4, \uBBF8\uC0AC\uD0A4\uC57C"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u0410\u0445, \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430,
          \u041C\u0438\u0441\u0430\u043A\u0438-\u0447\u0430\u043D."
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: Ah, es cierto Misaki-chan.
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: Ah, aivan oikein, Misaki-chan
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: Ah, c'est vrai Misaki-chan
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u3042\u3001\u305D\u3046\u3060\u7F8E\u54B2\u3061\u3083\u3093"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u554A\uFF0C\u539F\u6765\u5982\u6B64\uFF0C\u7F8E\u54B2\u9171"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
