        type: 0
        typeString: 
      - title: de
        value: Oma sagt mir...
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0926\u093E\u0926\u0940 \u092E\u0941\u091D\u0938\u0947 \u0915\u0939\u0924\u0940
          \u0939\u0948\u0902..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Nenek memberitahuku...
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: La nonna mi dice...
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Minha av\xF3 pediu para eu entregar\u2026 certo?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uD560\uBA38\uB2C8\uAED8\uC11C \uC804\uD574 \uB2EC\uB77C\uACE0 \uD558\uC168\uC5B4\u2026
          \uB9DE\uC9C0?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u043C\u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: La abuela me dice...
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Iso\xE4iti kertoo..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: "Grand-m\xE8re me dit..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u304A\u3070\u3042\u3061\u3083\u3093\u304B\u3089\u3063\u3066\u2026\u4F1D\u3048\u308B\u3093\u3060\u3088\u306D"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u5976\u5976\u544A\u8BC9\u6211..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: "\u5976\u5976\u544A\u8BC9\u6211..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: I'm supposed to say it's from Grandma, right?
        type: 4
        typeString: CustomFieldType_Localization
