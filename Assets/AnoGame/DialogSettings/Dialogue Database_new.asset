        type: 0
        typeString: 
      - title: de
        value: Oh, Misaki-chan. Bist du allein?
        type: 4
        typeString: CustomFieldType_Localization
      - title: hi
        value: "\u0913\u0939, \u092E\u093F\u0938\u093E\u0915\u0940-\u091A\u093E\u0928\u0964
          \u0905\u0915\u0947\u0932\u0940 \u0939\u094B?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: id
        value: Oh, Misaki-chan. Apakah kamu sendirian?
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Oh, Misaki-chan. Siete soli?
        type: 4
        typeString: CustomFieldType_Localization
      - title: pt
        value: "Ah, Misaki. Voc\xEA est\xE1 sozinha?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ko
        value: "\uC544\uB77C, \uBBF8\uC0AC\uD0A4\uC57C. \uD63C\uC790 \uC654\uB2C8?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: ru
        value: "\u041E, \u041C\u0438\u0441\u0430\u043A\u0438-\u0447\u0430\u043D.
          \u0422\u044B \u043E\u0434\u0438\u043D?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: es
        value: "Ah, Misaki-chan. \xBFEst\xE1s sola?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: Voi Misaki-chan. Oletko yksin?
        type: 4
        typeString: CustomFieldType_Localization
      - title: fr
        value: Oh, Misaki-chan. Es-tu seul?
        type: 4
        typeString: CustomFieldType_Localization
      - title: ja
        value: "\u3042\u3089\u3001\u7F8E\u54B2\u3061\u3083\u3093\u3002\u4E00\u4EBA\u306A\u306E\uFF1F"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-Hans
        value: "\u54E6\uFF0C\u7F8E\u54B2\u9171\u3002\u4F60\u4E00\u4E2A\u4EBA\u5417\uFF1F"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh-CN
        value: "\u54E6\uFF0C\u7F8E\u54B2\u9171\u3002\u4F60\u4E00\u4E2A\u4EBA\u5417\uFF1F"
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: Oh, Misaki-chan. Are you alone?
        type: 4
        typeString: CustomFieldType_Localization
