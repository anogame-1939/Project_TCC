/* ====================================
   デバッグパネル スタイルシート
   ==================================== */

/* ルート：画面右寄りの半透明パネル */
.debug-root {
    position: absolute;
    right: 20px;
    top: 20px;
    bottom: 20px;
    width: 480px;
    background-color: rgba(20, 20, 30, 0.92);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(100, 120, 255, 0.4);
    padding: 0;
    overflow: hidden;
}

/* タイトルバー */
.title-bar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(40, 45, 80, 0.95);
    padding: 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 120, 255, 0.3);
}

.title-label {
    font-size: 16px;
    color: rgb(200, 210, 255);
    -unity-font-style: bold;
}

/* ツールバー */
.toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 90, 140, 0.3);
    align-items: center;
}

.toolbar-btn {
    min-width: 80px;
    height: 30px;
    margin: 2px 4px;
    padding: 4px 10px;
    background-color: rgba(60, 65, 100, 0.9);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(100, 120, 255, 0.3);
    color: rgb(200, 210, 240);
    font-size: 12px;
    -unity-font-style: bold;
}

.toolbar-btn:hover {
    background-color: rgba(80, 90, 150, 0.95);
    border-color: rgba(130, 150, 255, 0.6);
}

.toolbar-btn:active {
    background-color: rgba(100, 110, 180, 0.95);
}

.chapter-dropdown {
    min-width: 160px;
    margin-left: 8px;
}

/* フィルターバー */
.filter-bar {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 90, 140, 0.3);
    align-items: center;
}

.episode-dropdown {
    min-width: 140px;
    margin-right: 8px;
}

.tag-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}

.tag-btn {
    height: 26px;
    min-width: 50px;
    margin: 2px 3px;
    padding: 3px 8px;
    background-color: rgba(50, 55, 85, 0.9);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(100, 120, 200, 0.3);
    color: rgb(170, 180, 220);
    font-size: 11px;
}

.tag-btn:hover {
    background-color: rgba(70, 78, 120, 0.95);
    border-color: rgba(130, 150, 255, 0.5);
}

.tag-btn--active {
    background-color: rgba(80, 100, 200, 0.85);
    border-color: rgba(140, 160, 255, 0.7);
    color: rgb(230, 235, 255);
}

.search-field {
    min-width: 100px;
    max-width: 140px;
    margin-left: 6px;
    height: 26px;
}

/* アイテムグリッド ScrollView */
.item-grid-scroll {
    flex-grow: 1;
    padding: 6px;
}

/* グリッドコンテナ (flexbox wrap) */
.item-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* アイテムカード */
.item-card {
    width: 105px;
    margin: 4px;
    padding: 6px;
    background-color: rgba(40, 45, 75, 0.9);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 180, 0.3);
    align-items: center;
}

.item-card:hover {
    background-color: rgba(55, 60, 100, 0.95);
    border-color: rgba(120, 140, 255, 0.5);
}

/* エピソードバッジ */
.item-card__episode-badge {
    background-color: rgba(70, 90, 180, 0.7);
    border-radius: 8px;
    padding: 1px 6px;
    margin-bottom: 3px;
    align-self: flex-start;
}

.item-card__episode-label {
    font-size: 9px;
    color: rgb(190, 200, 240);
}

/* アイテム名 */
.item-card__name {
    font-size: 11px;
    color: rgb(220, 225, 245);
    -unity-text-align: middle-center;
    margin: 4px 0;
    white-space: normal;
    min-height: 30px;
}

/* ボタン行 */
.item-card__buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}

.item-card__btn {
    width: 28px;
    height: 24px;
    margin: 0 2px;
    padding: 0;
    background-color: rgba(60, 70, 110, 0.95);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(90, 110, 200, 0.3);
    color: rgb(200, 210, 240);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.item-card__btn:hover {
    background-color: rgba(80, 95, 160, 0.95);
    border-color: rgba(130, 150, 255, 0.6);
}

.item-card__btn:active {
    background-color: rgba(100, 120, 190, 0.95);
}

.item-card__btn--consume {
    width: auto;
    min-width: 28px;
    padding: 0 4px;
    font-size: 10px;
    color: rgb(255, 180, 100);
}

.item-card__btn--consume:hover {
    background-color: rgba(120, 90, 50, 0.85);
    border-color: rgba(255, 180, 100, 0.6);
}
