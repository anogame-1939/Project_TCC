/* ================================================
   DialogueGraphWindow UIToolkit - Style Sheet
   ================================================ */

/* --- Main Window --- */
.dialogue-graph-root {
    flex-grow: 1;
    flex-direction: column;
}

/* --- Toolbar --- */
.dialogue-toolbar {
    flex-direction: row;
    height: 24px;
    background-color: #383838;
    border-bottom-width: 1px;
    border-bottom-color: #1a1a1a;
}

.dialogue-toolbar .unity-toolbar-button {
    -unity-text-align: middle-center;
}

/* --- Content Area (Sidebar + GraphView) --- */
.dialogue-content {
    flex-grow: 1;
    flex-direction: row;
    overflow: hidden;
}

/* Sidebar container — fixed width, does not grow */
.dialogue-sidebar-container {
    flex-shrink: 0;
    flex-grow: 0;
    overflow: hidden;
}

/* GraphView container — fills remaining space after sidebar */
.dialogue-graph-container {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* GraphView — positioned absolutely within container so layout.x = 0 */
.dialogue-graph-view {
    overflow: hidden;
}

/* --- Sidebar --- */
.dialogue-sidebar {
    width: 250px;
    min-width: 180px;
    max-width: 400px;
    background-color: #333333;
    border-right-width: 1px;
    border-right-color: #1a1a1a;
    flex-direction: column;
}

.sidebar-header {
    padding: 6px 8px;
    -unity-font-style: bold;
    font-size: 13px;
    color: #ddd;
    border-bottom-width: 1px;
    border-bottom-color: #222;
}

.sidebar-search {
    margin: 4px 6px;
    flex-shrink: 0;
}

.sidebar-search > .unity-toolbar-search-field__search-text-field {
    flex-grow: 1;
}

.sidebar-scroll {
    flex-grow: 1;
}

.sidebar-scroll-content {
    padding: 4px 0;
}

/* Episode Foldout */
.episode-foldout {
    margin-left: 4px;
    margin-top: 4px;
}

.episode-foldout > .unity-foldout__toggle {
    padding-top: 2px;
    padding-bottom: 2px;
}

.episode-foldout > .unity-foldout__toggle > .unity-toggle__input > .unity-label {
    -unity-font-style: bold;
    font-size: 12px;
    color: #ccc;
}

/* Chapter Row */
.chapter-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px 2px 4px;
    margin: 2px 5px 0 12px;
}

.chapter-label {
    -unity-font-style: bold;
    font-size: 11px;
    color: #bbb;
    flex-grow: 1;
}

.chapter-btn {
    width: 20px;
    height: 18px;
    font-size: 11px;
    -unity-text-align: middle-center;
    margin-left: 2px;
    margin-right: 0;
    padding: 0;
}

/* Section Row */
.section-row {
    flex-direction: row;
    align-items: center;
    padding: 1px 4px 1px 4px;
    border-radius: 3px;
    background-color: #444;
    margin: 1px 5px 1px 12px;
    cursor: arrow;
}

.section-row:hover {
    background-color: #555;
}

.section-row:active {
    background-color: #3a6ea5;
}

.section-name {
    flex-grow: 1;
    flex-shrink: 1;
    height: 20px;
    font-size: 11px;
    -unity-text-align: middle-left;
    padding-left: 4px;
    color: #ddd;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.section-count {
    flex-shrink: 0;
    height: 20px;
    min-width: 20px;
    font-size: 10px;
    -unity-text-align: middle-right;
    padding-right: 2px;
    color: #999;
}

.section-delete-btn {
    width: 18px;
    height: 18px;
    font-size: 10px;
    -unity-text-align: middle-center;
    padding: 0;
    margin-left: 2px;
    margin-right: 0;
    color: #ff6666;
    background-color: transparent;
    border-width: 0;
}

.section-delete-btn:hover {
    background-color: #553333;
}

/* --- Drag & Drop --- */
.drag-ghost {
    position: absolute;
    background-color: rgba(58, 110, 165, 0.85);
    border-radius: 4px;
    padding: 2px 8px;
    min-width: 80px;
    height: 20px;
    overflow: hidden;
}

.drag-ghost-label {
    color: #fff;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.drop-indicator {
    position: absolute;
    height: 3px;
    background-color: #4fc3f7;
    border-radius: 1px;
    z-index: 9999;
}

.section-row--dragging {
    opacity: 0.4;
}

.section-row--drag-over {
    background-color: rgba(79, 195, 247, 0.15);
    border-radius: 3px;
}

.sidebar-add-episode-btn {
    margin: 8px;
    height: 24px;
}

/* --- GraphView --- */
.dialogue-graph-view {
    flex-grow: 1;
}

/* --- Overlay Label --- */
.filter-overlay-label {
    position: absolute;
    left: 20px;
    top: 20px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.3);
}

.debug-overlay-label {
    position: absolute;
    right: 10px;
    bottom: 10px;
    font-size: 11px;
    color: yellow;
    -unity-text-align: lower-right;
}

/* --- Node Styles --- */
.dialogue-node {
    width: 250px;
    background-color: #2d2d2d; /* Default, overridden by actor color */
    border-radius: 8px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111;
    overflow: hidden; /* Ensure content obeys border radius */
}

/* Top port container (Input) */
.top-port-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 20px;
    background-color: transparent;
    border-width: 0;
}

.top-port-container .top-port {
    align-self: center;
    width: 12px;
}

.top-port-container .top-port #connector {
    border-color: #aaa;
    position: absolute;
    left: 50%;
    translate: -50% 0;
}

/* Bottom port container (Output / Next / Choices) */
.bottom-port-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-height: 20px;
    background-color: transparent;
    border-width: 0;
    padding: 2px 4px;
    flex-wrap: wrap;
}

.bottom-port-container .bottom-port {
    align-self: center;
    width: 12px;
}

.bottom-port-container .bottom-port #connector {
    border-color: #aaa;
    position: absolute;
    left: 50%;
    translate: -50% 0;
}

.dialogue-node #node-border {
    background-color: transparent;
}

.dialogue-node #title {
    color: white;
    height: 30px;
}

.dialogue-node #title-label {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    margin-left: 4px;
}

.dialogue-node #contents {
    background-color: transparent;
}

.dialogue-node #extension {
    background-color: transparent;
}

.dialogue-node #divider {
    display: none;
}

.dialogue-node .node-speaker-label {
    display: none; /* Removed in C#, but just in case */
}

.dialogue-node .node-speaker-dropdown {
    margin: 4px 8px;
    flex-grow: 1;
}

.dialogue-node .node-body-text {
    height: 60px; /* Approx 3 lines */
    min-height: 60px;
    max-height: 60px;
    margin: 4px 8px;
    white-space: normal;
    background-color: transparent;
    border-width: 0;
}

.dialogue-node .node-body-text > .unity-text-field__input {
    background-color: #1a1a1a;
    border-radius: 4px;
    border-color: #111;
    border-width: 1px;
    color: #eee;
    padding: 4px;
    white-space: normal;
    height: 100%;
}

.dialogue-node .choices-header {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
}

.dialogue-node .choices-label {
    -unity-font-style: bold;
    font-size: 11px;
    flex-grow: 1;
}

.dialogue-node .choice-add-btn {
    width: 20px;
    height: 18px;
    font-size: 12px;
}

.dialogue-node .choice-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    background-color: rgba(0, 0, 0, 0.2);
    margin-top: 2px;
    border-radius: 4px;
}

.dialogue-node .choice-text-field {
    flex-grow: 1;
    margin-right: 4px;
    min-width: 100px;
}

.dialogue-node .choice-delete-button {
    width: 20px;
    height: 18px;
    font-size: 10px;
    color: #ff6666;
    margin-right: 4px;
    background-color: #444;
    border-width: 0;
    border-radius: 3px;
}

.dialogue-node .choice-delete-button:hover {
    background-color: #555;
}

.dialogue-node .choice-port {
    height: 24px;
    align-self: center;
    justify-content: center;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.dialogue-node .choice-port > .unity-port__label {
    display: none;
}

.dialogue-node .choice-port > .unity-port__connector {
    margin-left: 0;
    margin-right: 0;
    border-color: #00ffff;
}

/* No data warning */
.no-data-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.no-data-label {
    font-size: 14px;
    color: #999;
    margin-bottom: 10px;
}
